# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Redis (optional - leave commented for development)
# REDIS_URL=redis://localhost:6379

# JWT Secrets (generate secure random strings)
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Chapa Payment
CHAPA_SECRET_KEY=your_chapa_secret_key

# Telebirr
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_app_key
TELEBIRR_SHORT_CODE=your_telebirr_short_code
TELEBIRR_PUBLIC_KEY=your_telebirr_public_key

# M-Pesa
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_PASSKEY=your_mpesa_passkey

# CBE Birr
CBE_MERCHANT_ID=your_cbe_merchant_id
CBE_API_KEY=your_cbe_api_key
CBE_API_SECRET=your_cbe_api_secret

# SMS Gateway — Afromessage (leave empty for dev mode)
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER=
AFROMESSAGE_SENDER=EthioGebiya

# Platform
PLATFORM_COMMISSION_RATE=0.05
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
